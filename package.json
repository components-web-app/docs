{
  "name": "cwa-docs",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "generate-pwa-assets": "pwa-assets-generator --preset minimal-2023 public/icon.png",
    "test": "playwright test",
    "test:update": "playwright test --update-snapshots",
    "test:chat": "esbuild scripts/chat/chat.test.ts --bundle --platform=node --format=esm --packages=external --log-level=warning --outfile=scripts/chat/.chat.test.mjs && node --test scripts/chat/.chat.test.mjs",
    "quiz:generate": "node scripts/quiz/generate.ts",
    "quiz:stamp": "node scripts/quiz/stamp.ts",
    "quiz:check": "node scripts/quiz/check.ts",
    "quiz:lock": "node scripts/quiz/lock.ts",
    "quiz:sample": "node scripts/quiz/sample.ts",
    "quiz:diversity": "node scripts/quiz/diversity.ts",
    "quiz:no-llm": "node scripts/quiz/no-llm.ts"
  },
  "dependencies": {
    "@comark/nuxt": "^0.8.1",
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/simple-icons": "^1.2.101",
    "@nuxt/content": "^3.16.2",
    "@nuxt/fonts": "^1.2.0",
    "@nuxt/image": "^2.2.1",
    "@nuxt/scripts": "^1.3.12",
    "@nuxt/ui": "^4.12.0",
    "@octokit/rest": "^22.0.1",
    "@resvg/resvg-js": "^2.6.2",
    "better-sqlite3": "^13.0.3",
    "highcharts": "^13.1.1",
    "nuxt": "^4.6.3",
    "nuxt-og-image": "^7.0.7",
    "nuxt-svgo": "^5.3.0",
    "satori": "^0.63.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@playwright/test": "^1.64.1",
    "@vite-pwa/assets-generator": "^2.0.0",
    "eslint": "^10.14.0",
    "vue-tsc": "3.3.13"
  },
  "packageManager": "pnpm@11.7.0"
}
