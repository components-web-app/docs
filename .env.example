# Production license for @nuxt/ui-pro, get one at https://ui.nuxt.com/pro/purchase
NUXT_UI_PRO_LICENSE=

# Public URL, used for OG Image when running nuxt generate
NUXT_PUBLIC_SITE_URL=http://localhost:3000

NUXT_GITHUB_TOKEN=

# Docs chat assistant (docs #1). With no key the build ships no chat button.
# Set on Vercel for both the build and the /api/chat edge function. Never commit a real key.
NUXT_ANTHROPIC_API_KEY=
# Local testing without a key: stream a canned answer with real retrieval and citations
NUXT_CHAT_MOCK=
